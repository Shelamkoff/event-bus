{
  "name": "@shelamkoff/event-bus",
  "version": "1.0.0",
  "description": "Small synchronous typed event bus with isolated handlers",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "README.ru.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build-package.mjs",
    "demo": "node scripts/demo-server.mjs",
    "test": "node --test",
    "prepublishOnly": "npm run check",
    "prepack": "npm run build",
    "typecheck": "tsc -p type-tests/tsconfig.json",
    "check": "npm run test && npm run typecheck && npm run build"
  },
  "keywords": [
    "event-bus",
    "events",
    "typescript",
    "esm"
  ],
  "author": "Shelamkoff",
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Shelamkoff/event-bus.git"
  },
  "homepage": "https://github.com/Shelamkoff/event-bus#readme",
  "bugs": {
    "url": "https://github.com/Shelamkoff/event-bus/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "typescript": "5.8.3"
  }
}
